# Runtime mode
APP_ENV=development
LOG_LEVEL=INFO
APP_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=drumscribe
POSTGRES_USER=drumscribe
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://drumscribe:local-development-only@postgres:5432/drumscribe

# Queue
REDIS_URL=redis://valkey:6379/0
QUEUE_EAGER=false

# Private S3-compatible object storage
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=drumscribe-private
S3_ACCESS_KEY=drumscribe-local
S3_SECRET_KEY=local-development-only
S3_SIGNED_URL_TTL_SECONDS=900

# Upload and retention policy
MAX_UPLOAD_BYTES=157286400
MAX_AUDIO_DURATION_SECONDS=720
ANONYMOUS_RETENTION_HOURS=24
DELETED_ASSET_GRACE_HOURS=24

# Audio / model providers
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SOURCE_SEPARATION_PROVIDER=development
DRUM_TRANSCRIPTION_PROVIDER=mock
ALLOW_RESEARCH_PROVIDERS=false
PROVIDER_REGISTRY_PATH=/app/MODEL_LICENSING.md

# Authentication. SMTP/Google are optional in local development.
SESSION_COOKIE_NAME=drumscribe_session
SESSION_COOKIE_SECURE=false
MAGIC_LINK_TTL_MINUTES=15
SMTP_URL=
EMAIL_FROM=DrumScribe <no-reply@example.test>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
FEATURE_TRIPLET_QUANTIZATION=true
FEATURE_ADVANCED_CYMBAL_CLASSIFICATION=false
FEATURE_VARIABLE_TEMPO=false
FEATURE_PRACTICE_MODE=true
FEATURE_MODEL_CONFIDENCE_OVERLAY=true

