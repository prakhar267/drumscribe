# Browser-facing web configuration (baked into the production web build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_APP_ENV=development
# Keep magic-link only for an offline development stack. Production uses neon.
NEXT_PUBLIC_AUTH_PROVIDER=magic-link
# NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters
# List only OAuth providers configured in Neon Auth; production uses google,github.
NEXT_PUBLIC_AUTH_SOCIAL_PROVIDERS=
ADMIN_UI_KEY=replace-with-a-long-random-local-admin-ui-key

# DrumScribe API runtime
DRUMSCRIBE_ENVIRONMENT=development
DRUMSCRIBE_SESSION_SECRET=replace-with-at-least-32-random-bytes
DRUMSCRIBE_PUBLIC_API_URL=http://localhost:8000
DRUMSCRIBE_WEB_ORIGINS=["http://localhost:3000"]
DRUMSCRIBE_ALLOWED_HOSTS=["localhost","127.0.0.1"]
DRUMSCRIBE_HSTS_MAX_AGE_SECONDS=31536000
DRUMSCRIBE_COOKIE_SECURE=false
DRUMSCRIBE_DEV_EXPOSE_MAGIC_LINK=true
DRUMSCRIBE_MAGIC_LINK_DELIVERY=development
DRUMSCRIBE_AUTO_CREATE_SCHEMA=false
DRUMSCRIBE_READINESS_TIMEOUT_SECONDS=10

# PostgreSQL container and API connection
POSTGRES_DB=drumscribe
POSTGRES_USER=drumscribe
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST_PORT=55432
DRUMSCRIBE_DATABASE_URL=postgresql+asyncpg://drumscribe:local-development-only@postgres:5432/drumscribe

# Durable background work
VALKEY_HOST_PORT=56379
DRUMSCRIBE_REDIS_URL=redis://valkey:6379/0
DRUMSCRIBE_QUEUE_BACKEND=celery

# Private S3-compatible object storage. The API uses the internal endpoint for
# operations and the public endpoint only when signing browser URLs.
S3_ACCESS_KEY=drumscribe-local
S3_SECRET_KEY=local-development-only
DRUMSCRIBE_STORAGE_BACKEND=s3
DRUMSCRIBE_S3_ENDPOINT_URL=http://minio:9000
DRUMSCRIBE_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
DRUMSCRIBE_S3_REGION=us-east-1
DRUMSCRIBE_S3_BUCKET=drumscribe-private
DRUMSCRIBE_S3_ACCESS_KEY_ID=drumscribe-local
DRUMSCRIBE_S3_SECRET_ACCESS_KEY=local-development-only
# auto disables unsupported AWS SSE request headers for Neon Object Storage and
# Cloudflare R2 while retaining AES256 for AWS/MinIO. Set explicitly only when required.
DRUMSCRIBE_S3_SERVER_SIDE_ENCRYPTION=auto
DRUMSCRIBE_S3_CONFIGURE_BUCKET_CORS=true
DRUMSCRIBE_SIGNED_URL_TTL_SECONDS=900

# Upload, retention, and editing limits
DRUMSCRIBE_MAX_UPLOAD_BYTES=157286400
DRUMSCRIBE_MAX_AUDIO_DURATION_SECONDS=720
DRUMSCRIBE_MAX_BULK_EVENTS=5000
DRUMSCRIBE_ANONYMOUS_RETENTION_HOURS=24
DRUMSCRIBE_EXPORT_RETENTION_HOURS=168

# Audio and model providers. `development` is deterministic and never accepted
# by the API's production safety gate.
DRUMSCRIBE_FFPROBE_BINARY=ffprobe
DRUMSCRIBE_PIPELINE_PROVIDER=development
DRUMSCRIBE_SOURCE_SEPARATION_PROVIDER=passthrough
DRUMSCRIBE_DEMUCS_MODEL=htdemucs_ft
# Optional protected Modal GPU endpoint. Set all three only after the Modal
# deployment passes a rights-cleared benchmark; otherwise Demucs runs locally.
DRUMSCRIBE_MODAL_DEMUCS_ENDPOINT=
DRUMSCRIBE_MODAL_PROXY_TOKEN_ID=
DRUMSCRIBE_MODAL_PROXY_TOKEN_SECRET=
DRUMSCRIBE_MODAL_MAX_RESPONSE_BYTES=268435456
DRUMSCRIBE_MUSIC_TRANSCRIPTION_PROVIDER=mock
DRUMSCRIBE_BEAT_TRACKING_PROVIDER=mock

# Commercial provider activation (server-side only). Production will not start
# unless every selected provider is commercial, credentials are present, and the
# approval references below are non-empty. Never place these keys in NEXT_PUBLIC_*.
DRUMSCRIBE_COMMERCIAL_PROVIDER_LICENSE_CONFIRMED=false
DRUMSCRIBE_COMMERCIAL_PROVIDER_APPROVAL_REFERENCE=
DRUMSCRIBE_PROVIDER_TIMEOUT_SECONDS=600
DRUMSCRIBE_PROVIDER_POLL_INTERVAL_SECONDS=2

# Process-isolated model commands. Each command is argv text; the API appends
# --input <audio> --output <contract.json> without invoking a shell.
# YourMT3+, OaF, ADTOF, and the hybrid remain research routes. The approved recall
# fusion receives both the normalized mix and aligned drum stem in production.
DRUMSCRIBE_YOURMT3_COMMAND=
DRUMSCRIBE_YOURMT3_MODEL_VERSION=YPTF.MoE+Multi-noPS
DRUMSCRIBE_OAF_DRUMS_COMMAND=
DRUMSCRIBE_OAF_DRUMS_MODEL_VERSION=e-gmd-checkpoint
DRUMSCRIBE_ADTOF_COMMAND=
DRUMSCRIBE_ADTOF_MODEL_VERSION=local-research
DRUMSCRIBE_HYBRID_COMMAND=
DRUMSCRIBE_HYBRID_MODEL_VERSION=drumscribe-hybrid-v1
DRUMSCRIBE_RECALL_FUSION_COMMAND=
DRUMSCRIBE_RECALL_FUSION_MODEL_VERSION=drumscribe-recall-fusion-v6
# Worker-only private checkpoint archive. The release tool prints the full SHA-256
# after `python -m drumscribe_api.model_bundle build`; never weaken this check.
DRUMSCRIBE_MODEL_BUNDLE_KEY=
DRUMSCRIBE_MODEL_BUNDLE_SHA256=

# AudioShake source separation: SOURCE_SEPARATION_PROVIDER=audioshake
DRUMSCRIBE_AUDIOSHAKE_API_URL=https://api.audioshake.ai
DRUMSCRIBE_AUDIOSHAKE_API_KEY=
DRUMSCRIBE_AUDIOSHAKE_CONTRACT_REFERENCE=
DRUMSCRIBE_AUDIOSHAKE_SEPARATION_MODEL=drums

# Music AI source separation: SOURCE_SEPARATION_PROVIDER=music_ai
DRUMSCRIBE_MUSIC_AI_API_URL=https://api.music.ai/v1
DRUMSCRIBE_MUSIC_AI_API_KEY=
DRUMSCRIBE_MUSIC_AI_CONTRACT_REFERENCE=
DRUMSCRIBE_MUSIC_AI_SEPARATION_WORKFLOW=
DRUMSCRIBE_MUSIC_AI_DRUM_RESULT_KEY=drums

# Klangio drum transcription and beat/downbeat tracking:
# MUSIC_TRANSCRIPTION_PROVIDER=klangio_drums, BEAT_TRACKING_PROVIDER=klangio
DRUMSCRIBE_KLANGIO_API_URL=https://api.klang.io
DRUMSCRIBE_KLANGIO_API_KEY=
DRUMSCRIBE_KLANGIO_CONTRACT_REFERENCE=

# Feature flags
DRUMSCRIBE_TRIPLET_QUANTIZATION=true
DRUMSCRIBE_ADVANCED_CYMBAL_CLASSIFICATION=false
DRUMSCRIBE_VARIABLE_TEMPO=false
DRUMSCRIBE_PRACTICE_MODE=true
DRUMSCRIBE_MODEL_CONFIDENCE_OVERLAY=true

# Legacy development/fallback magic-link delivery. Production uses Neon Auth
# email/password and social OAuth, with Resend SMTP for verification/reset mail.
DRUMSCRIBE_MAGIC_LINK_WEBHOOK_URL=
DRUMSCRIBE_MAGIC_LINK_WEBHOOK_SECRET=
DRUMSCRIBE_RESEND_API_URL=https://api.resend.com
DRUMSCRIBE_RESEND_API_KEY=
DRUMSCRIBE_RESEND_FROM_EMAIL="DrumScribe <sign-in@example.com>"
# Managed Better Auth JWT verification for the web-to-API identity bridge.
# DRUMSCRIBE_NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# DRUMSCRIBE_NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# One-time 10-credit checkout. Use test_mode until the signed webhook flow passes.
DRUMSCRIBE_BILLING_PROVIDER=disabled
DRUMSCRIBE_DODO_PAYMENTS_ENVIRONMENT=test_mode
DRUMSCRIBE_DODO_PAYMENTS_API_KEY=
DRUMSCRIBE_DODO_PAYMENTS_WEBHOOK_KEY=
DRUMSCRIBE_DODO_CREDIT_PACK_PRODUCT_ID=
DRUMSCRIBE_BILLING_RETURN_URL=http://localhost:3000/billing/success
DRUMSCRIBE_BILLING_CANCEL_URL=http://localhost:3000/pricing
DRUMSCRIBE_CREDIT_PACK_SIZE=10
