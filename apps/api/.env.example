DRUMSCRIBE_ENVIRONMENT=development
DRUMSCRIBE_DATABASE_URL=postgresql+asyncpg://drumscribe:drumscribe@localhost:5432/drumscribe
DRUMSCRIBE_REDIS_URL=redis://localhost:6379/0
DRUMSCRIBE_READINESS_TIMEOUT_SECONDS=2
DRUMSCRIBE_ENABLE_RATE_LIMITING=true
DRUMSCRIBE_RATE_LIMIT_PER_MINUTE=180
DRUMSCRIBE_AUTH_RATE_LIMIT_PER_MINUTE=10
DRUMSCRIBE_QUEUE_BACKEND=celery
DRUMSCRIBE_PIPELINE_PROVIDER=development
DRUMSCRIBE_SOURCE_SEPARATION_PROVIDER=passthrough
DRUMSCRIBE_MUSIC_TRANSCRIPTION_PROVIDER=mock
DRUMSCRIBE_BEAT_TRACKING_PROVIDER=mock
DRUMSCRIBE_STORAGE_BACKEND=s3
DRUMSCRIBE_S3_ENDPOINT_URL=http://localhost:9000
# In Compose use internal http://minio:9000 above and browser-reachable localhost below.
DRUMSCRIBE_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
DRUMSCRIBE_S3_CONFIGURE_BUCKET_CORS=true
DRUMSCRIBE_S3_REGION=us-east-1
DRUMSCRIBE_S3_BUCKET=drumscribe-private
DRUMSCRIBE_S3_ACCESS_KEY_ID=change-me
DRUMSCRIBE_S3_SECRET_ACCESS_KEY=change-me
DRUMSCRIBE_SESSION_SECRET=replace-with-at-least-32-random-characters
DRUMSCRIBE_PUBLIC_API_URL=http://localhost:8000
DRUMSCRIBE_WEB_ORIGINS=["http://localhost:3000"]
DRUMSCRIBE_COOKIE_SECURE=false
DRUMSCRIBE_DEV_EXPOSE_MAGIC_LINK=true
DRUMSCRIBE_ANONYMOUS_MAX_AUDIO_DURATION_SECONDS=90
DRUMSCRIBE_UNPROCESSED_UPLOAD_RETENTION_HOURS=24
DRUMSCRIBE_MAGIC_LINK_DELIVERY=development
# DRUMSCRIBE_MAGIC_LINK_WEBHOOK_URL=https://mailer.example.internal/v1/magic-links
# DRUMSCRIBE_MAGIC_LINK_WEBHOOK_SECRET=replace-me
# DRUMSCRIBE_RESEND_API_URL=https://api.resend.com
# DRUMSCRIBE_RESEND_API_KEY=re_example
# DRUMSCRIBE_RESEND_FROM_EMAIL="DrumScribe <sign-in@example.com>"
# DRUMSCRIBE_SENTRY_DSN=https://public-key@sentry.example/1
DRUMSCRIBE_SENTRY_TRACES_SAMPLE_RATE=0.0
