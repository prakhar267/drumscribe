NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_MAX_UPLOAD_BYTES=157286400
NEXT_PUBLIC_MAX_UPLOAD_SECONDS=720
ADMIN_UI_KEY=replace-with-a-long-random-value
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
# Use "neon" after Managed Better Auth and its API identity bridge are configured.
NEXT_PUBLIC_AUTH_PROVIDER=magic-link
# NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters
# Comma-separated; enable only providers with production OAuth credentials.
NEXT_PUBLIC_AUTH_SOCIAL_PROVIDERS=
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_AUTH_TOKEN=only-required-in-CI-for-source-map-upload
